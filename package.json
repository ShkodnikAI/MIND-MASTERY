{
  "name": "mindmastery",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 src/ app/ scripts/ content/",
    "format": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "validate-content": "tsx scripts/validate-content.ts",
    "validate-schema": "tsx scripts/validate-schema.ts",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-native-community/slider": "^5.2.0",

    "expo": "~53.0.0",
    "expo-audio": "~0.3.0",
    "expo-blur": "~14.0.0",
    "expo-brightness": "~13.0.0",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.0",
    "expo-document-picker": "~13.0.0",
    "expo-file-system": "~18.0.0",
    "expo-haptics": "~14.0.0",
    "expo-intent-launcher": "~12.0.0",
    "expo-keep-awake": "~14.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-localization": "~16.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-speech": "~13.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-updates": "~0.26.0",
    "i18next": "^23.0.0",
    "lottie-react-native": "~7.2.0",
    "react": "18.3.1",
    "react-i18next": "^15.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~8.0.0",
    "lefthook": "^1.7.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "ajv": "^8.11.0",
    "ajv-keywords": "^5.1.0"
  }
}
