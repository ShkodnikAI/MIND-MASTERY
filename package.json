{
  "name": "mindmastery",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 src/ app/ scripts/ content/",
    "format": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "validate-content": "tsx scripts/validate-content.ts",
    "validate-schema": "tsx scripts/validate-schema.ts",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/slider": "4.5.6",
    "expo": "~55.0.0",
    "expo-audio": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-brightness": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-device": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-intent-launcher": "~55.0.12",
    "expo-keep-awake": "~55.0.7",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-speech": "~55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-updates": "~55.0.21",
    "i18next": "^23.0.0",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-i18next": "^15.0.0",
    "react-native": "0.81.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "ajv": "^8.11.0",
    "ajv-keywords": "^5.1.0"
  }
}
